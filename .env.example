# ====================================================================
# STI 2026 — Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit actual secrets, keys, or passwords to git!
# ====================================================================

# Public site canonical base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------------------------------
# Supabase Configuration (Optional for local dev, Required for cloud DB)
# When omitted, CMS uses local JSON/filesystem store automatically.
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sti-media

# --------------------------------------------------------------------
# Admin Authentication & Session Security
# --------------------------------------------------------------------
# 32+ character random secret for signing admin session cookies
ADMIN_SESSION_SECRET=super-secret-development-session-signing-key-32chars

# Default local development credentials (DEVELOPMENT ONLY — NEVER USE IN PRODUCTION!)
# In production, configure non-guessable credentials via environment variables or Supabase Auth.
ADMIN_EMAIL=admin@sti2026.itb.ac.id
ADMIN_PASSWORD=AdminSTI2026!Editorial
ADMIN_DEFAULT_ROLE=admin

EDITOR_EMAIL=editor@sti2026.itb.ac.id
EDITOR_PASSWORD=EditorSTI2026!Content

# --------------------------------------------------------------------
# Media Upload Configuration
# --------------------------------------------------------------------
# Storage driver: 'local' (writes to public/uploads) or 'supabase' (uses storage bucket)
STORAGE_DRIVER=local
STORAGE_UPLOAD_DIR=public/uploads
MAX_IMAGE_SIZE_BYTES=10485760 # 10MB
MAX_VIDEO_SIZE_BYTES=52428800 # 50MB
